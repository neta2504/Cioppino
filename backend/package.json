{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "description": "Cioppino local monitoring backend",
  "license": "MIT",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "npm run test:pricing && npm run test:agents",
    "test:pricing": "tsx --test tests/pricing.test.ts",
    "test:agents": "tsx --test tests/agents.test.ts"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "jsonc-parser": "^3.3.1",
    "yaml": "^2.8.1",
    "systeminformation": "^5.33.14"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
